generator client {
  provider = "prisma-client"
  // Keep generated client inside src/ for easy imports in Next.js
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  operator
  admin
}

/// Etapas del seguimiento de importación (distinto del `stage` string en Quote, que es flujo de cotización).
enum OperationStage {
  INICIADA
  ORDEN_COMPRA
  EMBARQUE
  ADUANA
  ENTREGA
  COMPLETADA
}

enum NotificationType {
  STAGE_CHANGED
  EVENT_ADDED
  DOCUMENT_ADDED
}

model Quote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  anonId    String
  mode      String
  userText  String
  sourceUrl String?

  productJson Json?
  quoteJson   Json

  // Optional numeric helpers for filtering/sorting later.
  totalMinUsd Float?
  totalMaxUsd Float?

  stage   String @default("quoted") // quoted | decision_requested | lead_captured | refined
  leadId  String?
  lead    Lead?  @relation(fields: [leadId], references: [id])

  userId String?
  user   User? @relation(fields: [userId], references: [id])

  /// Si existe, esta cotización pasó a importación acompañada por Ecomex.
  operation Operation?

  comments QuoteComment[]
  audits   AuditLog[]

  @@index([anonId, createdAt])
  @@index([leadId])
  @@index([userId, createdAt])
}

model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  anonId  String
  contact String
  channel String // email | whatsapp | unknown

  userId String?
  user   User? @relation(fields: [userId], references: [id])

  quotes Quote[]

  @@index([anonId, createdAt])
  @@unique([contact])
  @@index([userId, createdAt])
}

model User {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  email        String   @unique
  passwordHash String

  role               UserRole @default(user)
  onboardingSeenAt   DateTime?

  quotes            Quote[]
  leads             Lead[]
  operatorBudgets   OperatorBudget[]
  quoteComments     QuoteComment[]
  audits            AuditLog[]

  /// Importaciones en curso (Operation) donde el usuario es el cliente.
  operations Operation[]
  /// Proveedores cargados por el usuario (directorio).
  suppliers  Supplier[]

  notifications Notification[]
}

model OperatorBudget {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  createdByUserId String
  createdByUser   User @relation(fields: [createdByUserId], references: [id])

  rubro        String?
  productTitle String?

  filename    String
  xlsxBytes   Bytes
  imageBytes  Bytes
  imageType   String

  parsedJson Json?
  audits AuditLog[]
}

model QuoteComment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  quoteId String
  quote   Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  authorUserId String?
  authorUser   User? @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  authorRole  String
  authorLabel String?
  message     String

  @@index([quoteId, createdAt])
  @@index([authorUserId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  entityType String
  entityId   String
  action     String
  payload    Json?

  actorUserId String?
  actorUser   User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorRole   String?

  quoteId String?
  quote   Quote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  operatorBudgetId String?
  operatorBudget   OperatorBudget? @relation(fields: [operatorBudgetId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([quoteId, createdAt])
  @@index([operatorBudgetId, createdAt])
  @@index([actorUserId, createdAt])
}

/// Importación ejecutada a partir de una cotización (`Quote`). Una cotización tiene como máximo una Operation.
model Operation {
  id      String @id @default(cuid())
  quoteId String @unique
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stage OperationStage @default(INICIADA)

  /// M:N — un proveedor puede participar en varias importaciones; una importación puede tener varios proveedores.
  suppliers Supplier[]

  documents OperationDocument[]
  timeline  OperationEvent[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, stage])
  @@index([stage, updatedAt])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  operationId String?
  operation   Operation? @relation(fields: [operationId], references: [id], onDelete: SetNull)
  type        NotificationType
  title       String
  body        String?
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}

/// Directorio de proveedores por usuario; asociación a importaciones vía relación M:N con Operation.
model Supplier {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name    String
  country String
  contact String?

  operations Operation[]

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model OperationDocument {
  id          String @id @default(cuid())
  operationId String
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  name       String
  url        String
  uploadedBy String

  createdAt DateTime @default(now())

  @@index([operationId, createdAt])
}

model OperationEvent {
  id          String @id @default(cuid())
  operationId String
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  stage       OperationStage
  description String
  actor       String

  createdAt DateTime @default(now())

  @@index([operationId, createdAt])
}
